@page "/shop/{slug}/order/{id:guid}"
@model OnlineShop.Api.Pages.Storefront.OrderConfirmationModel
@{
    var order = Model.Order;
    ViewData["Title"] = order is null ? "Order" : $"Order {order.OrderNumber}";
    var slug = Model.Shop?.Slug ?? string.Empty;
}

<partial name="_StorefrontHeader" model="Model" />

@if (order is null)
{
    <div class="alert alert-warning">Order not found.</div>
    return;
}

<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card mb-3">
            <div class="card-body text-center py-4">
                <h1 class="h4 mb-1">Thank you</h1>
                <p class="text-muted mb-2">
                    Order <code>@order.OrderNumber</code> was placed on
                    @order.PlacedAt.ToString("d MMM yyyy 'at' HH:mm") UTC.
                </p>
                <partial name="_OrderStatusBadge" model="order.Status" />
            </div>
        </div>

        <div class="card mb-3">
            <div class="card-body">
                <h2 class="h6 mb-3">What you ordered</h2>
                <table class="table table-sm align-middle mb-0">
                    <tbody>
                        @foreach (var item in order.Items)
                        {
                            <tr>
                                <td>
                                    @item.ProductName
                                    <span class="text-muted small">&times; @item.Quantity</span>
                                    <div class="small text-muted"><code>@item.Sku</code></div>
                                </td>
                                <td class="numeric">@item.LineTotal.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                    <tfoot>
                        <tr>
                            <th>Total</th>
                            <th class="numeric">@order.GrandTotal.ToString("N2") @order.CurrencyCode</th>
                        </tr>
                    </tfoot>
                </table>
            </div>
        </div>

        <div class="alert alert-info small">
            <strong>This page was served by the primary database.</strong>
            Your order was written moments ago, and the read replica that serves ordinary browsing
            may not have it yet. Rather than risk showing you a missing order, this one read asks
            for strong consistency &mdash; the one documented exception to reads going to the replica.
        </div>

        <a asp-page="Index" asp-route-slug="@slug" class="btn btn-outline-secondary">Back to the shop</a>
    </div>
</div>
