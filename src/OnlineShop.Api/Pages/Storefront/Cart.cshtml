@page "/shop/{slug}/cart"
@model OnlineShop.Api.Pages.Storefront.CartModel
@{
    ViewData["Title"] = "Basket";
    var cart = Model.Cart;
    var currency = cart?.CurrencyCode ?? Model.Shop?.CurrencyCode ?? "USD";
    var slug = Model.Shop?.Slug ?? string.Empty;
}

<partial name="_StorefrontHeader" model="Model" />

<h1 class="h4 mb-3">Your basket</h1>

@if (cart is null || cart.IsEmpty)
{
    <div class="card"><div class="card-body empty-state">
        <p class="mb-2">Your basket is empty.</p>
        <a asp-page="Index" asp-route-slug="@slug" class="btn btn-primary btn-sm">Browse the shop</a>
    </div></div>
    return;
}

@if (cart.HasUnavailableLines)
{
    <div class="alert alert-warning">
        Some items are no longer available in the quantity you asked for. Adjust them before checking out.
    </div>
}

<div class="row g-3">
    <div class="col-lg-8">
        <div class="card">
            <div class="table-responsive">
                <table class="table align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Product</th>
                            <th class="numeric">Unit</th>
                            <th style="width:11rem;">Quantity</th>
                            <th class="numeric">Total</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var line in cart.Lines)
                        {
                            <tr class="@(line.IsAvailable ? "" : "table-warning")">
                                <td>
                                    <a class="text-decoration-none text-reset"
                                       asp-page="Product" asp-route-slug="@slug" asp-route-id="@line.ProductId">
                                        @line.ProductName
                                    </a>
                                    <div class="small text-muted"><code>@line.Sku</code></div>
                                    @if (!line.IsActive)
                                    {
                                        <div class="small text-danger">No longer on sale</div>
                                    }
                                    else if (line.QuantityAvailable < line.Quantity)
                                    {
                                        <div class="small text-danger">Only @line.QuantityAvailable left</div>
                                    }
                                    @if (line.PriceChanged)
                                    {
                                        <div class="small text-muted">
                                            Now @line.CurrentPrice.ToString("N2") @currency — checkout uses the current price
                                        </div>
                                    }
                                </td>
                                <td class="numeric">@line.UnitPrice.ToString("N2")</td>
                                <td>
                                    <form method="post" asp-page-handler="Update"
                                          asp-route-slug="@slug" asp-route-productId="@line.ProductId"
                                          class="d-flex gap-1">
                                        <input type="number" name="quantity" value="@line.Quantity"
                                               min="0" max="999" class="form-control form-control-sm" />
                                        <button type="submit" class="btn btn-sm btn-outline-secondary">Set</button>
                                    </form>
                                </td>
                                <td class="numeric">@line.LineTotal.ToString("N2")</td>
                                <td class="text-end">
                                    <form method="post" asp-page-handler="Remove"
                                          asp-route-slug="@slug" asp-route-productId="@line.ProductId">
                                        <button type="submit" class="btn btn-sm btn-outline-danger">Remove</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
        <p class="small text-muted mt-2">
            Setting a quantity to zero removes the line. Quantities are absolute, so a refresh or a
            double submit cannot change the basket twice.
        </p>
    </div>

    <div class="col-lg-4">
        <div class="card">
            <div class="card-body">
                <h2 class="h6 mb-3">Summary</h2>
                <div class="d-flex justify-content-between mb-2">
                    <span>Items</span><span>@cart.TotalQuantity</span>
                </div>
                <div class="d-flex justify-content-between fw-semibold border-top pt-2">
                    <span>Subtotal</span><span>@cart.Subtotal.ToString("N2") @currency</span>
                </div>

                <a asp-page="Checkout" asp-route-slug="@slug"
                   class="btn btn-primary w-100 mt-3 @(cart.HasUnavailableLines ? "disabled" : "")">
                    Checkout
                </a>
            </div>
        </div>
    </div>
</div>
