@page "/shop/{slug}"
@model OnlineShop.Api.Pages.Storefront.IndexModel
@{
    ViewData["Title"] = Model.Shop?.Name ?? "Shop";
    var currency = Model.Shop?.CurrencyCode ?? "USD";
}

<partial name="_StorefrontHeader" model="Model" />

<form method="get" class="row g-2 mb-4">
    <div class="col-sm-6 col-md-4">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search this shop" />
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Search</button>
        @if (!string.IsNullOrWhiteSpace(Model.Search))
        {
            <a asp-page="/Storefront/Index" asp-route-slug="@Model.Shop!.Slug"
               class="btn btn-link">Clear</a>
        }
    </div>
</form>

@if (Model.Products.TotalCount == 0)
{
    <div class="card"><div class="card-body empty-state">
        <p class="mb-0">
            @(string.IsNullOrWhiteSpace(Model.Search)
                ? "This shop has no products on sale yet."
                : $"Nothing matches \"{Model.Search}\".")
        </p>
    </div></div>
}
else
{
    <div class="row g-3">
        @foreach (var product in Model.Products.Items)
        {
            <div class="col-6 col-md-4 col-lg-3">
                <div class="card product-card">
                    <div class="product-thumb">@product.Name.Substring(0, 1).ToUpperInvariant()</div>
                    <div class="card-body d-flex flex-column">
                        <h2 class="h6 mb-1">
                            <a class="text-decoration-none text-reset"
                               asp-page="/Storefront/Product" asp-route-slug="@Model.Shop!.Slug"
                               asp-route-id="@product.Id">@product.Name</a>
                        </h2>
                        <p class="small text-muted mb-2">@product.Sku</p>
                        <p class="price fw-semibold mb-2">@product.Price.ToString("N2") @currency</p>

                        @if (product.QuantityAvailable <= 0)
                        {
                            <span class="badge bg-secondary align-self-start mt-auto">Out of stock</span>
                        }
                        else
                        {
                            <span class="small text-muted mt-auto">@product.QuantityAvailable available</span>
                        }
                    </div>
                </div>
            </div>
        }
    </div>

    @if (Model.Products.TotalPages > 1)
    {
        <nav class="mt-4">
            <ul class="pagination pagination-sm">
                @for (var pageNumber = 1; pageNumber <= Model.Products.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.Products.Page ? "active" : "")">
                        <a class="page-link"
                           asp-route-slug="@Model.Shop!.Slug"
                           asp-route-search="@Model.Search"
                           asp-route-pageNumber="@pageNumber">@pageNumber</a>
                    </li>
                }
            </ul>
        </nav>
    }
}
