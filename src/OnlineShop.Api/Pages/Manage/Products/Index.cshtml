@page
@model OnlineShop.Api.Pages.Manage.Products.IndexModel
@{
    ViewData["Title"] = "Products";
    var currency = Model.CurrentShop?.CurrencyCode ?? "USD";
}

<partial name="_ManageHeader" model="Model" />

@if (Model.CurrentShop is null)
{
    <div class="card"><div class="card-body empty-state">
        <h2 class="h5">No shops yet</h2>
        <a asp-page="/Manage/Shops/Create" class="btn btn-primary">Create a shop</a>
    </div></div>
    return;
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <h1 class="h4 mb-0">
        Products
        <partial name="_ConsistencyBadge" model="Model.Consistency" />
    </h1>
    <a asp-page="Create" asp-route-shopId="@Model.CurrentShop.Id" class="btn btn-primary">Add product</a>
</div>

<form method="get" class="row g-2 mb-3">
    <input type="hidden" name="shopId" value="@Model.CurrentShop.Id" />
    <div class="col-sm-6 col-md-4">
        <input name="search" value="@Model.Search" class="form-control" placeholder="Search name or SKU" />
    </div>
    <div class="col-sm-4 col-md-3">
        <select name="status" class="form-select">
            <option value="">Any status</option>
            @foreach (var status in Enum.GetValues<ProductStatus>())
            {
                <option value="@status" selected="@(Model.Status == status)">@status</option>
            }
        </select>
    </div>
    <div class="col-auto">
        <button type="submit" class="btn btn-outline-secondary">Filter</button>
    </div>
</form>

@if (Model.Products.TotalCount == 0)
{
    <div class="card"><div class="card-body empty-state">
        <p class="mb-2">No products match.</p>
        <a asp-page="Create" asp-route-shopId="@Model.CurrentShop.Id" class="btn btn-primary btn-sm">Add your first product</a>
    </div></div>
}
else
{
    <div class="card">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>SKU</th>
                        <th>Status</th>
                        <th class="numeric">Price</th>
                        <th class="numeric">Available</th>
                        <th></th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var product in Model.Products.Items)
                    {
                        <tr>
                            <td>@product.Name</td>
                            <td><code class="small">@product.Sku</code></td>
                            <td><partial name="_ProductStatusBadge" model="product.Status" /></td>
                            <td class="numeric">@product.Price.ToString("N2") @currency</td>
                            <td class="numeric @(product.QuantityAvailable <= 0 ? "text-danger fw-semibold" : "")">
                                @product.QuantityAvailable
                            </td>
                            <td class="text-end">
                                <a asp-page="Edit" asp-route-id="@product.Id" asp-route-shopId="@Model.CurrentShop.Id"
                                   class="btn btn-sm btn-outline-secondary">Edit</a>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    @if (Model.Products.TotalPages > 1)
    {
        <nav class="mt-3">
            <ul class="pagination pagination-sm">
                @for (var pageNumber = 1; pageNumber <= Model.Products.TotalPages; pageNumber++)
                {
                    <li class="page-item @(pageNumber == Model.Products.Page ? "active" : "")">
                        <a class="page-link"
                           asp-route-shopId="@Model.CurrentShop.Id"
                           asp-route-search="@Model.Search"
                           asp-route-status="@Model.Status"
                           asp-route-page="@pageNumber">@pageNumber</a>
                    </li>
                }
            </ul>
        </nav>
    }

    <p class="text-muted small mt-2">@Model.Products.TotalCount product(s)</p>
}
