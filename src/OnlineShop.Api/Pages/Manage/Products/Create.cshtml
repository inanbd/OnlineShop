@page
@model OnlineShop.Api.Pages.Manage.Products.CreateModel
@{
    ViewData["Title"] = "Add product";
    var currency = Model.CurrentShop?.CurrencyCode ?? "USD";
}

<partial name="_ManageHeader" model="Model" />

<div class="row">
    <div class="col-lg-8">
        <h1 class="h4 mb-3">Add product</h1>

        <div class="card">
            <div class="card-body">
                <form method="post">
                    <input type="hidden" name="shopId" value="@Model.CurrentShop?.Id" />
                    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                    <div class="row g-3">
                        <div class="col-md-8">
                            <label asp-for="Input.Name" class="form-label"></label>
                            <input asp-for="Input.Name" class="form-control" autofocus />
                            <span asp-validation-for="Input.Name" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.Sku" class="form-label"></label>
                            <input asp-for="Input.Sku" class="form-control" />
                            <div class="form-text">Unique within this shop.</div>
                            <span asp-validation-for="Input.Sku" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <label asp-for="Input.Description" class="form-label"></label>
                            <textarea asp-for="Input.Description" class="form-control" rows="3"></textarea>
                            <span asp-validation-for="Input.Description" class="text-danger small"></span>
                        </div>

                        <div class="col-md-4">
                            <label asp-for="Input.Price" class="form-label"></label>
                            <div class="input-group">
                                <input asp-for="Input.Price" class="form-control" type="number" step="0.01" min="0" />
                                <span class="input-group-text">@currency</span>
                            </div>
                            <span asp-validation-for="Input.Price" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.InitialQuantityOnHand" class="form-label"></label>
                            <input asp-for="Input.InitialQuantityOnHand" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Input.InitialQuantityOnHand" class="text-danger small"></span>
                        </div>
                        <div class="col-md-4">
                            <label asp-for="Input.ReorderThreshold" class="form-label"></label>
                            <input asp-for="Input.ReorderThreshold" class="form-control" type="number" min="0" />
                            <span asp-validation-for="Input.ReorderThreshold" class="text-danger small"></span>
                        </div>

                        <div class="col-12">
                            <div class="form-check">
                                <input asp-for="Input.PublishImmediately" class="form-check-input" />
                                <label asp-for="Input.PublishImmediately" class="form-check-label"></label>
                                <div class="form-text">Unpublished products stay as drafts and are hidden from the storefront.</div>
                            </div>
                        </div>
                    </div>

                    <div class="mt-4 d-flex gap-2">
                        <button type="submit" class="btn btn-primary">Create product</button>
                        <a asp-page="Index" asp-route-shopId="@Model.CurrentShop?.Id" class="btn btn-outline-secondary">Cancel</a>
                    </div>
                </form>
            </div>
        </div>

        <p class="text-muted small mt-3">
            The product row and its opening stock record are written under a single transaction,
            so the catalog can never hold a product with no inventory.
        </p>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
